        "skharness",
        "skmemory",
        "skos",
        "skseal",
        "sksecurity",
        "skseed",
        "skskills",
        "skvault",
        "skvoice"
      ],
      "mustNot": [],
      "required": [
        "skcapstone"
      ]
    },
    "stateTier": "full-replica",
    "syncFolders": [
      "skcapstone-sync",
      "skfleet-control"
    ],
    "units": {

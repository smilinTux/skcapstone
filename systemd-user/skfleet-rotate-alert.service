[Unit]
Description=Alert + ITIL incident when the fleet rotation fails (chiap08 authority node only)
Documentation=card ba72dcb9. Wired 2026-08-30 after a 40min fleet-wide dispatch outage went unnoticed.

[Service]
Type=oneshot
Environment=PATH=%h/.skenv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/skfleet-rotate-alert.sh
# Best effort by design: this must never turn a rotation failure into a second failure.
SuccessExitStatus=0 1

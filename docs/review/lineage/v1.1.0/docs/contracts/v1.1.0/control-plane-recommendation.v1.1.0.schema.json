{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skworld.local/skdashboard/control-plane-recommendation.v1.1.0.schema.json",
  "title": "SKDashboard evidence-linked recommendation version 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recommendation_id",
    "schema_version",
    "status",
    "title",
    "recommendation_type",
    "urgency",
    "rationale",
    "metric_refs",
    "evidence_refs",
    "best_practice_refs",
    "expected_impact",
    "confidence",
    "risks",
    "counter_indicators",
    "alternatives",
    "preconditions",
    "next_step"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "status": {
      "enum": ["proposed", "abstained"]
    },
    "recommendation_id": {
      "type": "string",
      "pattern": "^rec-[a-z0-9][a-z0-9-]{7,95}$"
    },
    "title": {"type": "string", "maxLength": 240},
    "recommendation_type": {
      "enum": [
        "inspect",
        "plan",
        "rebalance",
        "mitigate_risk",
        "improve_flow",
        "improve_reliability",
        "improve_quality",
        "reduce_cost",
        "improve_data_quality",
        "draft_report",
        "preview_action"
      ]
    },
    "urgency": {"enum": ["now", "this_cycle", "monitor", "opportunity"]},
    "rationale": {"type": "string", "maxLength": 3000},
    "abstention_reason": {"type": "string", "minLength": 1, "maxLength": 1000},
    "metric_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"type": "string", "maxLength": 256}
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {"type": "string", "maxLength": 512}
    },
    "best_practice_refs": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["framework", "practice", "version", "reference"],
        "properties": {
          "framework": {"type": "string", "maxLength": 128},
          "practice": {"type": "string", "maxLength": 240},
          "version": {"type": "string", "maxLength": 64},
          "reference": {"type": "string", "maxLength": 512}
        }
      }
    },
    "expected_impact": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["metric_id", "direction", "range", "horizon", "method"],
        "properties": {
          "metric_id": {"type": "string", "maxLength": 128},
          "direction": {"enum": ["increase", "decrease", "stabilize", "unknown"]},
          "range": {"type": "string", "maxLength": 128},
          "horizon": {"type": "string", "maxLength": 128},
          "method": {"type": "string", "maxLength": 256}
        }
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "basis"],
      "properties": {
        "level": {"type": "number", "minimum": 0, "maximum": 1},
        "basis": {"type": "string", "maxLength": 500}
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "maxLength": 500}
    },
    "counter_indicators": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "maxLength": 500}
    },
    "alternatives": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "tradeoff"],
        "properties": {
          "label": {"type": "string", "maxLength": 240},
          "tradeoff": {"type": "string", "maxLength": 800}
        }
      }
    },
    "preconditions": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "maxLength": 500}
    },
    "next_step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label"],
      "properties": {
        "kind": {
          "enum": ["none", "open_evidence", "save_view", "draft_report", "preview_action"]
        },
        "label": {"type": "string", "maxLength": 200},
        "target_ref": {"type": ["string", "null"], "maxLength": 512},
        "action_contract_id": {"type": ["string", "null"], "maxLength": 128},
        "parameter_proposal_ref": {"type": ["string", "null"], "maxLength": 512}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["status", "recommendation_type"],
        "properties": {
          "status": {"const": "proposed"},
          "recommendation_type": {
            "enum": [
              "plan",
              "rebalance",
              "mitigate_risk",
              "improve_flow",
              "improve_reliability",
              "improve_quality",
              "reduce_cost",
              "improve_data_quality",
              "draft_report",
              "preview_action"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "best_practice_refs": {"minItems": 1},
          "expected_impact": {"minItems": 1},
          "risks": {"minItems": 1},
          "counter_indicators": {"minItems": 1},
          "alternatives": {"minItems": 1},
          "preconditions": {"minItems": 1}
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "abstained"}}
      },
      "then": {
        "required": ["abstention_reason"]
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "proposed"}}
      },
      "then": {
        "not": {"required": ["abstention_reason"]}
      }
    }
  ]
}

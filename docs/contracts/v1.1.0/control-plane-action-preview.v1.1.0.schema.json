{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skworld.local/skdashboard/control-plane-action-preview.v1.1.0.schema.json",
  "title": "SKDashboard governed action authorization preview version 1.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "preview_id",
    "preview_hash",
    "schema_version",
    "status",
    "action_class",
    "source_recommendation_id",
    "action_contract_id",
    "action_contract_version",
    "owner_service",
    "owner_operation",
    "target",
    "expected_version",
    "before_summary",
    "proposed_effect",
    "blast_radius",
    "risk",
    "reversibility",
    "verification_plan",
    "rollback_plan",
    "required_scope",
    "required_approvals",
    "policy_decision_ref",
    "expires_at"
  ],
  "properties": {
    "preview_id": {
      "type": "string",
      "pattern": "^apv-[a-z0-9][a-z0-9-]{7,95}$"
    },
    "preview_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "schema_version": {"const": "1.1.0"},
    "status": {
      "enum": ["ready", "denied", "needs_information", "needs_approval", "stale", "expired"]
    },
    "action_class": {
      "enum": [
        "read_only",
        "low_risk_internal",
        "high_risk",
        "external",
        "destructive",
        "protected_matter"
      ]
    },
    "source_recommendation_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "action_contract_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "action_contract_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "owner_service": {"type": "string", "minLength": 1, "maxLength": 128},
    "owner_operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "target": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {"pattern": "\\S"},
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S",
        "maxLength": 256
      }
    },
    "expected_version": {"type": ["string", "null"], "maxLength": 256},
    "before_summary": {"type": "string", "minLength": 1, "maxLength": 1500},
    "proposed_effect": {"type": "string", "minLength": 1, "maxLength": 1500},
    "blast_radius": {"type": "string", "minLength": 1, "maxLength": 1000},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reasons"],
      "properties": {
        "level": {"enum": ["low", "medium", "high", "critical"]},
        "reasons": {
          "type": "array",
          "maxItems": 32,
          "items": {"type": "string", "minLength": 1, "maxLength": 500}
        }
      }
    },
    "reversibility": {"enum": ["automatic", "manual", "limited", "irreversible"]},
    "verification_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "rollback_plan": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"type": "string", "minLength": 1, "maxLength": 500}
    },
    "required_scope": {"type": "string", "minLength": 1, "maxLength": 128},
    "required_approvals": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approval_type", "state", "exact_version_required", "current"],
        "properties": {
          "approval_type": {"type": "string", "minLength": 1, "maxLength": 128},
          "state": {"enum": ["not_required", "required", "approved", "rejected", "expired"]},
          "exact_version_required": {"type": "boolean"},
          "current": {"type": "boolean"}
        }
      }
    },
    "policy_decision_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "denial_reasons": {
      "type": "array",
      "maxItems": 32,
      "items": {"type": "string", "maxLength": 500}
    },
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "ready"}}
      },
      "then": {
        "properties": {
          "required_approvals": {
            "items": {
              "required": ["state", "exact_version_required", "current"],
              "properties": {
                "state": {"const": "approved"},
                "exact_version_required": {"const": true},
                "current": {"const": true}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "required": ["status", "action_class"],
        "properties": {
          "status": {"const": "ready"},
          "action_class": {
            "enum": ["high_risk", "external", "destructive", "protected_matter"]
          }
        }
      },
      "then": {
        "properties": {
          "required_approvals": {
            "minItems": 1,
            "items": {
              "required": ["state", "exact_version_required", "current"],
              "properties": {
                "state": {"const": "approved"},
                "exact_version_required": {"const": true},
                "current": {"const": true}
              }
            },
            "contains": {
              "type": "object",
              "required": ["state", "exact_version_required", "current"],
              "properties": {
                "state": {"const": "approved"},
                "exact_version_required": {"const": true},
                "current": {"const": true}
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "required": ["status", "action_class"],
        "properties": {
          "status": {"const": "ready"},
          "action_class": {"not": {"const": "read_only"}}
        }
      },
      "then": {
        "properties": {
          "target": {"minProperties": 1},
          "expected_version": {"type": "string", "minLength": 1, "pattern": "\\S"}
        }
      }
    },
    {
      "if": {
        "required": ["status", "action_class"],
        "properties": {
          "status": {"const": "needs_approval"},
          "action_class": {
            "enum": ["high_risk", "external", "destructive", "protected_matter"]
          }
        }
      },
      "then": {
        "properties": {
          "required_approvals": {
            "minItems": 1,
            "items": {
              "required": ["current"],
              "properties": {"current": {"const": true}}
            },
            "contains": {
              "type": "object",
              "required": ["state", "exact_version_required", "current"],
              "properties": {
                "state": {"const": "required"},
                "exact_version_required": {"const": true},
                "current": {"const": true}
              }
            },
            "minContains": 1
          }
        }
      }
    },
    {
      "if": {
        "required": ["status"],
        "properties": {"status": {"const": "denied"}}
      },
      "then": {
        "required": ["denial_reasons"],
        "properties": {
          "denial_reasons": {"minItems": 1}
        }
      }
    }
  ]
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.skworld.local/skdashboard/schedule/v1.0.0/control-plane-schedule-scenario.v1.0.0.schema.json",
  "title": "SKDashboard immutable schedule scenario version 1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scenario_id", "scenario_version", "scenario_hash", "source_projection_id", "source_projection_version", "source_projection_hash", "immutable", "mode", "input_hash", "inputs", "diff", "reset_ref", "writes_owner_records", "created_at"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "scenario_id": {"type": "string", "pattern": "^scn-[a-z0-9][a-z0-9-]{7,95}$"},
    "scenario_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "scenario_hash": {"$ref": "control-plane-schedule-projection.v1.0.0.schema.json#/$defs/hash"},
    "source_projection_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_projection_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_projection_hash": {"$ref": "control-plane-schedule-projection.v1.0.0.schema.json#/$defs/hash"},
    "immutable": {"const": true},
    "mode": {"const": "no_write"},
    "input_hash": {"$ref": "control-plane-schedule-projection.v1.0.0.schema.json#/$defs/hash"},
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "dependency_slips", "milestone_moves", "itil_windows", "architecture_sequence"],
      "properties": {
        "capacity": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/change"}},
        "dependency_slips": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/change"}},
        "milestone_moves": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/change"}},
        "itil_windows": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/change"}},
        "architecture_sequence": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/change"}}
      }
    },
    "diff": {"type": "array", "maxItems": 5000, "items": {"$ref": "#/$defs/change"}},
    "reset_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "writes_owner_records": {"const": false},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_id", "field", "before", "after"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "field": {"enum": ["capacity", "dependency_lag", "planned_start", "planned_target", "itil_window", "architecture_sequence"]},
        "before": {},
        "after": {}
      }
    }
  }
}

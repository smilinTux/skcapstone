[Unit]
Description=SKFleet Link role-bounded observation producer
After=network-online.target
Before=skfleet-link.service

[Service]
# Fleet authority/node service: files and dirs created here must be owner-only
# (a 0002 umask made evidence dirs 0775 and the guarded reviewer handoff refused them).
UMask=0077
Type=oneshot
Environment=SKAGENT=link-producer
Environment=SKCAPSTONE_AGENT=link-producer
Environment=SKFLEET_LINK_REPOSITORIES=smilinTux/skcapstone,smilinTux/skdashboard,smilinTux/skworld,smilinTux/sk-standards,https://skgit.skstack01.douno.it/smilinTux/sklegal
EnvironmentFile=-%h/api-keys/link-skgit.env
Environment=PATH=%h/.skenv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.skenv/bin/python3 %h/.skenv/bin/skfleet-link-producer.py
TimeoutStartSec=180
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
# Atomic replacement requires write access to the containing directory. The
# wrapper fixes all writable output names and accepts no path arguments.
ReadWritePaths=%h/.skcapstone/coordination

[Install]
WantedBy=default.target

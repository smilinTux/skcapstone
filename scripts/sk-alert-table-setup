#!/usr/bin/env python3
"""sk-alert-table-setup: create this estate's "SK Alerts" table in Nextcloud Tables.

sk-alert writes one row per alert condition into it, so the estate's alert
history can be queried ("what failed most this week") instead of scrolled.
Run it ONCE per estate, as the account sk-alert posts as (lumina on nor, jarvis
on chi), on a node that has that account's Talk credentials. It prints the
table id to put in config/alert.env as SKALERT_TABLE_ID.

    sk-alert-table-setup                       # create, print the id
    sk-alert-table-setup --share dknestri      # also share it (read + update)
    sk-alert-table-setup --table 7 --share mrarch   # share an existing table

Credentials are read the way sk-alert reads them (config/alert.env, then
config/alert.secret, then ~/.hermes/.env) and are never printed.
"""

import argparse
import base64
import json
import os
import sys
import urllib.error
import urllib.request
from pathlib import Path

# The column set sk-alert writes. sk-alert finds columns by TITLE, so renaming
# one in the Tables UI stops that field from being written (nothing breaks).
STATUS = ["open", "ack", "resolved", "fyi"]
SEVERITY = ["info", "warn", "crit"]
COLUMNS = [
    ("Alert", "text", "line", {}),
    ("Status", "selection", "", {"opts": STATUS, "default": 0}),
    ("Severity", "selection", "", {"opts": SEVERITY, "default": 0}),
    ("Host", "text", "line", {}),
    ("Estate", "text", "line", {}),
    ("First seen", "datetime", "", {}),
    ("Last seen", "datetime", "", {}),
    ("Alerts sent", "number", "", {}),
    ("Last message", "text", "long", {}),
    ("Talk thread", "text", "line", {}),
    ("Resolved at", "datetime", "", {}),
    ("Key", "text", "line", {}),
    ("Notes", "text", "long", {}),
]


def load_env() -> dict:
    home = Path(os.environ.get("SKCAPSTONE_HOME", Path.home() / ".skcapstone"))
    env = {}
    files = [home / "config/alert.env", home / "config/alert.secret",
             Path(os.environ.get("SKALERT_ENV_FILE", Path.home() / ".hermes/.env"))]
    for f in files:
        try:
            for line in f.read_text().splitlines():
                line = line.strip()
                if not line or line.startswith("#") or "=" not in line:
                    continue
                k, v = line.split("=", 1)
                env.setdefault(k.strip(), v.strip().strip('"').strip("'"))
        except OSError:
            pass
    for k in ("NEXTCLOUD_TALK_SERVER_URL", "NEXTCLOUD_TALK_USERNAME", "NEXTCLOUD_TALK_APP_PASSWORD"):
        if os.environ.get(k):
            env[k] = os.environ[k]
    return env


class Api:
    def __init__(self, env: dict):
        try:
            self.url = env["NEXTCLOUD_TALK_SERVER_URL"].rstrip("/")
            cred = f'{env["NEXTCLOUD_TALK_USERNAME"]}:{env["NEXTCLOUD_TALK_APP_PASSWORD"]}'
        except KeyError as e:
            sys.exit(f"sk-alert-table-setup: missing {e.args[0]} (see sk-alert CONFIG RESOLUTION)")
        self.auth = "Basic " + base64.b64encode(cred.encode()).decode()

    def call(self, method: str, path: str, body=None):
        data = json.dumps(body).encode() if body is not None else None
        req = urllib.request.Request(
            self.url + "/index.php/apps/tables/api/1" + path, data=data, method=method,
            headers={"Authorization": self.auth, "OCS-APIRequest": "true",
                     "Accept": "application/json", "Content-Type": "application/json"})
        try:
            with urllib.request.urlopen(req, timeout=30) as r:
                return json.loads(r.read() or b"null")
        except urllib.error.HTTPError as e:
            sys.exit(f"sk-alert-table-setup: {method} {path} -> HTTP {e.code} {e.read()[:300]!r}")


def create(api: Api, title: str) -> int:
    table = api.call("POST", "/tables", {"title": title, "emoji": "\U0001F6A8",
                                         "description": "One row per alert condition, written by sk-alert."})
    tid = table["id"]
    for name, typ, sub, extra in COLUMNS:
        body = {"title": name, "type": typ, "subtype": sub, "mandatory": False}
        if typ == "selection":
            body["selectionOptions"] = json.dumps([{"id": i, "label": o} for i, o in enumerate(extra["opts"])])
            body["selectionDefault"] = str(extra["default"])
        if typ == "number":
            body["numberDecimals"] = 0
        api.call("POST", f"/tables/{tid}/columns", body)
    return tid


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    p.add_argument("--title", default="SK Alerts")
    p.add_argument("--table", type=int, help="existing table id (skip creation)")
    p.add_argument("--share", action="append", default=[],
                   help="user to share with (read + update, so they can ack and add notes)")
    a = p.parse_args()
    api = Api(load_env())
    tid = a.table or create(api, a.title)
    for user in a.share:
        api.call("POST", f"/tables/{tid}/shares", {
            "receiver": user, "receiverType": "user", "permissionRead": True,
            "permissionCreate": False, "permissionUpdate": True,
            "permissionDelete": False, "permissionManage": False})
    print(f"SKALERT_TABLE_ID={tid}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

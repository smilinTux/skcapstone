#!/usr/bin/env python3
"""Consume rotation failures and turn a repeated outage into one ITIL incident.

This is deliberately the consumer behind skcapstone-alert@, not a second
notification transport. Only the pinned control node writes the shared ITIL
record, avoiding Syncthing's multi-writer incident storm.
"""
import argparse, json, os, socket, subprocess, tempfile
from pathlib import Path

THRESHOLD = 2  # two consecutive five-minute fires proves a repeat, not a blip
AUTHORITY = os.environ.get("SKFLEET_ALERT_AUTHORITY", "noroc2027")
STATE = Path(os.environ.get("SKFLEET_ALERT_STATE", "~/.local/state/skfleet-rotate-alert.json")).expanduser()


def _load():
    try:
        with STATE.open() as f:
            value = json.load(f)
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def _save(value):
    STATE.parent.mkdir(parents=True, exist_ok=True)
    fd, name = tempfile.mkstemp(dir=STATE.parent, prefix=".rotate-alert-")
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(value, f, sort_keys=True, separators=(",", ":"))
            f.write("\n")
        os.replace(name, STATE)
    finally:
        try: os.unlink(name)
        except FileNotFoundError: pass


def _itil(*args):
    return subprocess.run(["skcapstone", "itil", "incident", *args], text=True,
                          capture_output=True, check=False)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--unit", default="skfleet-rotate.service")
    ap.add_argument("--error", default="exit status indicates repeated rotation failure")
    ap.add_argument("--recovered", action="store_true")
    ns = ap.parse_args()
    state = _load()
    if ns.recovered:
        iid = state.get("incident")
        if iid and socket.gethostname() == AUTHORITY:
            _itil("update", iid, "--agent", "skfleet-rotate-alert", "--status", "resolved",
                  "--note", "rotation recovered; next scheduled fire succeeded",
                  "--resolution", "dispatcher recovered")
        state = {"failures": 0}
        _save(state)
        return 0
    failures = int(state.get("failures", 0)) + 1
    state["failures"] = failures
    if failures >= THRESHOLD and socket.gethostname() == AUTHORITY and not state.get("incident"):
        title = "Repeated skfleet rotation failure"
        result = _itil("create", "--title", title, "--severity", "sev2", "--service", ns.unit,
                       "--impact", "Ready cards cannot be dispatched; fleet capacity drains",
                       "--by", "skfleet-rotate-alert", "--tag", "fleet", "--tag", "rotation",
                       "--tag", "single-node-authority")
        # CLI prints the ID; retain only its token, never treat lifecycle as evidence.
        for token in result.stdout.split():
            if token.startswith("INC-"):
                state["incident"] = token
                break
    _save(state)
    msg = "%s repeated failure %d/%d on %s: %s" % (ns.unit, failures, THRESHOLD, socket.gethostname(), ns.error)
    subprocess.run(["systemd-cat", "-t", "skcapstone-alert", "-p", "err"], input=msg + "\n", text=True, check=False)
    return 0

if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Retire stale idle agent projections into a reversible quarantine.

A projection is retired only when its identity-valid filename has an ephemeral
worker generation suffix and it has had no last_seen or file modification
within RETIRE_AFTER_DAYS. A stale task holder additionally requires fresh exact
negative process, unit, and direct-seat observations plus folded CardStore
custody mismatch. Ambiguous, identity-mismatched, standing, and Syncthing
conflict files are never touched. Moves are recorded in a JSONL manifest and
reversible with --restore.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import shutil
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Callable

RETIRE_AFTER_DAYS = 30
PROOF_MAX_AGE = timedelta(minutes=5)
GLOB = "*.json"
EPHEMERAL_SUFFIX = re.compile(r"(?:^|[-_.])[0-9a-f]{8}$", re.IGNORECASE)


def agents_dir() -> Path:
    return Path.home() / ".skcapstone" / "coordination" / "agents"


def quarantine_dir() -> Path:
    return agents_dir().parent / "agents-quarantine"


def manifest_path() -> Path:
    return quarantine_dir() / "manifest.jsonl"


def parse_last_seen(value: object) -> datetime | None:
    if not isinstance(value, str) or not value:
        return None
    try:
        observed = datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    # Offset-naive timestamps are not safely comparable to UTC; fail closed.
    if observed.tzinfo is None:
        return None
    return observed


def sha256_of(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for chunk in iter(lambda: stream.read(65536), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_agent(path: Path, agent: str) -> bool:
    """Strict filename identity: no dots, separators, or traversal in agent."""
    if not agent or any(bad in agent for bad in (".", "/", "\\")):
        return False
    return path.name == f"{agent}.json"


def ephemeral_agent(agent: str) -> bool:
    """Recognize a bounded worker generation without naming its provider."""

    return EPHEMERAL_SUFFIX.search(agent) is not None


def folded_claim_identity(card_id: str) -> tuple[str | None, str]:
    """Return authoritative folded owner and claim revision for one card."""

    from skcoord.card_store import CardStore

    card = CardStore(Path.home() / ".skcapstone").fold(card_id)
    if card is None:
        raise ValueError("card is absent")
    return card.owner, str(card.meta.get("_claim_revision") or "")


class ProofError(RuntimeError):
    """Raised when stale-task proof is absent or ambiguous."""


def load_stale_task_proofs(path: Path | None, now: datetime) -> dict[tuple[str, str, str], dict]:
    """Load fresh, exact negative runtime observations for stale task holders."""

    if path is None:
        return {}
    if path.is_symlink() or not path.is_file():
        raise ProofError("stale-task proof must be a regular file")
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        raise ProofError(f"stale-task proof is unreadable: {type(exc).__name__}") from exc
    if not isinstance(payload, list) or len(payload) > 1000:
        raise ProofError("stale-task proof must be a bounded list")
    proofs: dict[tuple[str, str, str], dict] = {}
    for record in payload:
        if not isinstance(record, dict):
            raise ProofError("stale-task proof record is not an object")
        owner, card_id, claim_revision = (
            record.get(key) for key in ("owner", "card_id", "claim_revision")
        )
        if not all(isinstance(value, str) and value for value in (owner, card_id, claim_revision)):
            raise ProofError("stale-task proof identity is incomplete")
        observed = parse_last_seen(record.get("observed_at"))
        if observed is None or not timedelta(0) <= now - observed <= PROOF_MAX_AGE:
            raise ProofError("stale-task proof observation is not fresh")
        if any(
            type(record.get(key)) is not bool
            for key in ("process_alive", "active_worker_unit", "direct_seat_record")
        ):
            raise ProofError("stale-task runtime proof is ambiguous")
        key = str(owner), str(card_id), str(claim_revision)
        if key in proofs:
            raise ProofError("duplicate stale-task proof identity")
        proofs[key] = record
    return proofs


def assess(
    path: Path,
    now: datetime,
    stale_task_proofs: dict[tuple[str, str, str], dict] | None = None,
    claim_lookup: Callable[[str], tuple[str | None, str]] | None = None,
) -> tuple[bool, str, str]:
    """Classify one projection and return retirement disposition."""

    if path.is_symlink() or not path.is_file():
        return False, "non-regular projection stays diagnostic", "diagnostic"
    if ".sync-conflict-" in path.name:
        return False, "sync-conflict copy stays for monitor diagnostics", "diagnostic"
    try:
        projection = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        return False, f"malformed stays: {type(exc).__name__}", "diagnostic"
    if not isinstance(projection, dict):
        return False, "malformed stays: not an object", "diagnostic"
    agent = projection.get("agent", "")
    if not isinstance(agent, str) or not agent or agent != path.stem:
        return False, "identity mismatch stays diagnostic", "diagnostic"
    if not canonical_agent(path, agent):
        return False, "non-canonical filename stays diagnostic", "diagnostic"
    if not ephemeral_agent(agent):
        return False, "standing or non-ephemeral identity stays", "standing"
    task = projection.get("current_task", "")
    disposition = "stale-idle"
    if task not in (None, ""):
        claimed = projection.get("claimed_tasks", [])
        revision = projection.get("_claim_revision", "")
        if (
            not isinstance(task, str)
            or not re.fullmatch(r"[0-9a-f]{8}", task, re.IGNORECASE)
            or not isinstance(revision, str)
            or not revision
            or claimed != [task]
        ):
            return False, "task identity is ambiguous", "diagnostic"
        key = (agent, task, revision)
        proof = (stale_task_proofs or {}).get(key)
        if proof is None:
            return False, "task holder lacks exact runtime proof", "diagnostic"
        if any(
            proof.get(field) is not False
            for field in ("process_alive", "active_worker_unit", "direct_seat_record")
        ):
            return False, "task holder has live or ambiguous runtime evidence", "diagnostic"
        try:
            folded_owner, folded_revision = (claim_lookup or folded_claim_identity)(task)
        except (OSError, ValueError, TypeError):
            return False, "folded CardStore custody is ambiguous", "diagnostic"
        if folded_owner == agent and folded_revision == revision:
            return False, "task holder still matches folded custody", "active"
        disposition = "stale-task-non-exact"
    observed = parse_last_seen(projection.get("last_seen"))
    if observed is None:
        return False, "unreadable last_seen stays", "diagnostic"
    modified = datetime.fromtimestamp(path.stat().st_mtime, tz=timezone.utc)
    cutoff = now - timedelta(days=RETIRE_AFTER_DAYS)
    if observed >= cutoff:
        return False, f"seen {int((now - observed).total_seconds() // 3600)}h ago", "young"
    if modified >= cutoff:
        return False, "file modified inside the retirement window", "young"
    # ponytail: 300s tolerates filesystem timestamp granularity, nothing wider.
    if (observed - modified).total_seconds() > 300:
        return False, "last_seen newer than mtime stays (rollback evidence)", "diagnostic"
    return True, f"inactive since {observed.isoformat()}", disposition


def eligible(path: Path, now: datetime) -> tuple[bool, str]:
    """Return the legacy two-field idle-retirement decision."""

    retire, reason, _disposition = assess(path, now)
    return retire, reason


class ManifestError(RuntimeError):
    """Raised when the manifest history is malformed; all mutation refuses."""


def parse_manifest_lines() -> list[dict]:
    if not manifest_path().exists():
        return []
    records: list[dict] = []
    for number, line in enumerate(
        manifest_path().read_text(encoding="utf-8").splitlines(), start=1
    ):
        if not line.strip():
            continue
        try:
            record = json.loads(line)
        except json.JSONDecodeError as exc:
            raise ManifestError(f"manifest line {number} is malformed") from exc
        if not isinstance(record, dict):
            raise ManifestError(f"manifest line {number} is not an object")
        records.append(record)
    return records


def append_manifest(record: dict) -> None:
    # Standing rail: parse every existing line before appending anything.
    parse_manifest_lines()
    quarantine_dir().mkdir(parents=True, exist_ok=True)
    with manifest_path().open("a", encoding="utf-8") as stream:
        stream.write(json.dumps(record, sort_keys=True) + "\n")


def moved_records() -> dict[str, dict]:
    """filename -> latest manifest record, honoring later restored events."""
    state: dict[str, dict] = {}
    for record in parse_manifest_lines():
        filename = record.get("filename")
        if not isinstance(filename, str):
            raise ManifestError("manifest record without a filename")
        if record.get("event") == "moved":
            state[filename] = record
        elif record.get("event") == "restored":
            state.pop(filename, None)
    return state


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--apply", action="store_true", help="perform the moves (default: dry run)"
    )
    parser.add_argument("--restore", metavar="FILENAME", help="move one quarantined file back")
    parser.add_argument(
        "--stale-task-proof",
        type=Path,
        help="fresh bounded runtime proof for non-exact task holders",
    )
    args = parser.parse_args(argv)

    now = datetime.now(timezone.utc)
    try:
        stale_task_proofs = load_stale_task_proofs(args.stale_task_proof, now)
    except ProofError as exc:
        print(f"refusing stale-task reconciliation: {exc}")
        return 1

    if args.restore:
        try:
            record = moved_records().get(args.restore)
        except ManifestError as exc:
            print(f"refusing restore: {exc}")
            return 1
        if record is None:
            print(f"no quarantined record for {args.restore}")
            return 1
        source = quarantine_dir() / args.restore
        target = Path(str(record.get("original_path") or ""))
        agents = agents_dir().resolve()
        confined = (
            target.name == args.restore
            and target.is_absolute()
            and target.resolve(strict=False).is_relative_to(agents)
        )
        if not source.is_file() or not confined:
            print(f"cannot restore {args.restore}: source missing or unconfined path")
            return 1
        if sha256_of(source) != record.get("sha256"):
            print(f"cannot restore {args.restore}: digest mismatch against manifest")
            return 1
        if target.exists():
            print(f"cannot restore {args.restore}: original path already exists")
            return 1
        target.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(source), str(target))
        append_manifest(
            {
                "event": "restored",
                "filename": args.restore,
                "restored_at": now.isoformat(),
            }
        )
        print(f"restored {args.restore} to {target}")
        return 0

    retired = skipped = 0
    if args.apply:
        try:
            parse_manifest_lines()
        except ManifestError as exc:
            print(f"refusing to apply: {exc}")
            return 1
    for path in sorted(agents_dir().glob(GLOB)):
        ok, reason, disposition = assess(path, now, stale_task_proofs)
        if not ok:
            skipped += 1
            continue
        if not args.apply:
            print(f"RETIRE {path.name} ({reason})")
            retired += 1
            continue
        destination = quarantine_dir() / path.name
        if destination.exists():
            print(f"SKIP {path.name}: already quarantined")
            skipped += 1
            continue
        digest = sha256_of(path)
        size = path.stat().st_size
        quarantine_dir().mkdir(parents=True, exist_ok=True)
        shutil.move(str(path), str(destination))
        append_manifest(
            {
                "event": "moved",
                "filename": path.name,
                "original_path": str(path),
                "sha256": digest,
                "bytes": size,
                "disposition": disposition,
                "observed_at": now.isoformat(),
                "moved_at": now.isoformat(),
                "rollback": f"--restore {path.name}",
            }
        )
        print(f"MOVED {path.name} ({reason})")
        retired += 1

    mode = "applied" if args.apply else "dry run"
    print(f"{mode}: {retired} retired, {skipped} kept, quarantine={quarantine_dir()}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

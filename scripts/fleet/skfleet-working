#!/usr/bin/env python3
# ruff: noqa: E501
"""Show fleet worker truth from processes and transient systemd units.

Pi print mode buffers normal output until completion. Log age is therefore
context, never liveness. The process, its cgroup, exact agent projection, and
duplicate card generations are the useful signals.
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from collections import Counter
from dataclasses import dataclass

HOSTS = tuple(os.environ.get("SKFLEET_HOSTS", "chiap01 chiap02 chiap03 chiap04 chiap08").split())


@dataclass(frozen=True)
class Worker:
    host: str
    agent: str
    card: str
    pid: int
    elapsed: int
    cpu: int
    log_bytes: int
    log_age: int
    unit: str
    tmux: bool
    claim_state: str


REMOTE = r"""
import glob,json,os,subprocess,time
host=os.uname().nodename.split('.')[0]
now=int(time.time())
try:
    tmux=set(subprocess.run(['tmux','list-sessions','-F','#{session_name}'],capture_output=True,text=True).stdout.split())
except Exception:
    tmux=set()
for raw in glob.glob('/proc/[0-9]*/comm'):
    try:
        pid=int(raw.split('/')[2])
        if open(raw).read().strip()!='pi': continue
        env=dict(x.split('=',1) for x in open('/proc/%d/environ'%pid,'rb').read().decode(errors='replace').split('\0') if '=' in x)
        agent=env.get('SKAGENT','')
        card=agent.rsplit('-',1)[-1]
        if not agent.startswith('pi-') or len(card)!=8: continue
        stat=open('/proc/%d/stat'%pid).read().split()
        ticks=os.sysconf(os.sysconf_names['SC_CLK_TCK'])
        uptime=float(open('/proc/uptime').read().split()[0])
        elapsed=max(0,int(uptime-(int(stat[21])/ticks)))
        cpu=int((int(stat[13])+int(stat[14]))/ticks)
        cg=open('/proc/%d/cgroup'%pid).read()
        unit=next((part for part in cg.replace('\\x2d','-').split('/') if part.startswith('skfleet-worker-') and part.endswith('.service')),'legacy')
        logs=glob.glob(os.path.expanduser('~/.skcapstone/fleet/logs/%s-*.log'%card))
        log=max(logs,key=os.path.getmtime) if logs else ''
        size=os.path.getsize(log) if log else -1
        age=now-int(os.path.getmtime(log)) if log else -1
        legacy_live=any(card in name for name in tmux)
        projection=os.path.expanduser('~/.skcapstone/coordination/agents/%s.json'%agent)
        claim='projection-missing'
        if os.path.exists(projection):
            data=json.load(open(projection))
            claim='exact' if data.get('current_task')==card and data.get('state')=='active' else 'mismatch'
        print(json.dumps(dict(host=host,agent=agent,card=card,pid=pid,elapsed=elapsed,cpu=cpu,log_bytes=size,log_age=age,unit=unit,tmux=legacy_live,claim_state=claim),sort_keys=True))
    except (FileNotFoundError,ProcessLookupError,PermissionError,ValueError,KeyError,json.JSONDecodeError):
        pass
"""


def duration(seconds: int) -> str:
    if seconds < 0:
        return "-"
    if seconds < 60:
        return f"{seconds}s"
    if seconds < 3600:
        return f"{seconds // 60}m{seconds % 60:02d}s"
    return f"{seconds // 3600}h{(seconds % 3600) // 60:02d}m"


def collect(host: str) -> list[Worker]:
    result = subprocess.run(
        [
            "ssh",
            "-o",
            "BatchMode=yes",
            "-o",
            "ConnectTimeout=6",
            f"skuser01@{host}",
            "python3",
            "-c",
            REMOTE,
        ],
        capture_output=True,
        text=True,
        timeout=25,
    )
    rows = []
    for line in result.stdout.splitlines():
        try:
            rows.append(Worker(**json.loads(line)))
        except (TypeError, json.JSONDecodeError):
            continue
    return rows


def main() -> int:
    rows = []
    unreachable = []
    for host in HOSTS:
        try:
            rows.extend(collect(host))
        except (subprocess.TimeoutExpired, OSError):
            unreachable.append(host)
    rows.sort(key=lambda row: (-row.elapsed, row.host, row.agent))
    counts = Counter(row.card for row in rows)
    print(f"fleet worker processes: {len(rows)} across {len({row.host for row in rows})} host(s)")
    print(
        "source of truth: pi processes plus transient worker cgroups and exact agent projections"
    )
    print("-" * 124)
    print(
        f"  {'host':8} {'worker':38} {'elapsed':>9} {'cpu':>7} {'log':>9} {'log age':>9} {'owner':18} state"
    )
    alerts = []
    for row in rows:
        owner = (
            row.unit.removesuffix(".service")
            if row.unit != "legacy"
            else ("legacy-tmux" if row.tmux else "orphan-process")
        )
        state = "running; output buffered until completion"
        if counts[row.card] > 1:
            state = "DUPLICATE card process"
            alerts.append((row, "duplicate"))
        elif owner == "orphan-process":
            state = "ORPHAN: no unit or tmux owner"
            alerts.append((row, "orphan"))
        elif row.claim_state != "exact":
            state = f"CLAIM {row.claim_state}"
            alerts.append((row, "claim"))
        log = "absent" if row.log_bytes < 0 else f"{row.log_bytes}B"
        print(
            f"  {row.host:8} {row.agent[:38]:38} {duration(row.elapsed):>9} {duration(row.cpu):>7} {log:>9} {duration(row.log_age):>9} {owner[:18]:18} {state}"
        )
    if not rows:
        print("no fleet worker processes found. This says nothing about board eligibility.")
    print()
    if unreachable:
        print("unreachable hosts: " + ", ".join(unreachable))
    if alerts:
        print(f"ACTION REQUIRED ({len(alerts)}):")
        for row, kind in alerts:
            print(f"  {row.host} {row.agent}: {kind}")
    else:
        print("no duplicate, orphan, or claim-mismatch process detected")
    print("log age is informational only and never proves a stall for pi print mode")
    return 1 if alerts or unreachable else 0


if __name__ == "__main__":
    sys.exit(main())

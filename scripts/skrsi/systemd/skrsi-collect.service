[Unit]
Description=SKRSI daily evidence collection into this estate's skrsi instance repo
After=network-online.target

[Service]
Type=oneshot
# SKRSI_INSTANCE: local clone of the instance repo (pushes evidence/** only).
# The script path names the skcapstone checkout on purpose: skcapstone deploy
# rewrites it to the released tools export (sk-release tools.skcapstone).
# SKRSI_NODE: this node's short name in cluster.yaml when it is not the hostname.
EnvironmentFile=%h/.config/skrsi/collect.env
ExecStart=/usr/bin/python3 %h/clawd/skcapstone-repos/skcapstone/scripts/skrsi/collect_instance.py --instance ${SKRSI_INSTANCE} --push
Nice=10

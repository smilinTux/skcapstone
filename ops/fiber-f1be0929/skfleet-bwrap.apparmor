# Narrow executable attachment based on AppArmor's apparmor-4.0
# profiles/extras/bwrap-userns-restrict (GPL-2.0).
# Keep host user-namespace restrictions enabled. Child capabilities are denied.
abi <abi/4.0>,
include <tunables/global>
profile skfleet_bwrap /usr/bin/bwrap flags=(attach_disconnected,mediate_deleted) {
  allow capability,
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow px /** -> skfleet_bwrap//&skfleet_unpriv_bwrap,
}
profile skfleet_unpriv_bwrap flags=(attach_disconnected,mediate_deleted) {
  allow file rwlkm /{**,},
  allow network,
  allow unix,
  allow ptrace,
  allow signal,
  allow mqueue,
  allow io_uring,
  allow userns,
  allow mount,
  allow umount,
  allow pivot_root,
  allow dbus,
  allow pix /** -> &skfleet_unpriv_bwrap,
  audit deny capability,
}

[Unit]
Description=SKFleet Niobe bounded live dispatcher
After=network-online.target
OnFailure=skfleet-rotate-alert.service

[Service]
Type=oneshot
Environment=SKAGENT=niobe
Environment=SKCAPSTONE_AGENT=niobe
Environment=PATH=%h/.skenv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=%h/.config/skcapstone/skfleet-niobe-live.env
Environment=SKFLEET_MAX_LAUNCH=10
Environment=SKFLEET_BEAT_INTERVAL=60
ExecStart=%h/.skenv/bin/python3 -m skcapstone.niobe_live_entrypoint --activation %h/.skcapstone/coordination/niobe-activation.json --dispatcher %h/.skenv/bin/skfleet-rotate.py --unit skfleet-niobe-live.timer
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target

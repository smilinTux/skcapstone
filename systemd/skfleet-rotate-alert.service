# Reuses the skcapstone-alert transport for the fleet dispatcher.
# The instance is the failed unit name, for example skfleet-rotate.service.
[Unit]
Description=SKFleet repeated rotation failure alert - %i
After=skcapstone-alert@.service

[Service]
Type=oneshot
Environment=PATH=%h/.skenv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/skfleet-rotate-alert --unit %i

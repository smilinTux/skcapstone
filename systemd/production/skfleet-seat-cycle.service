[Unit]
Description=SKFleet canonical serialized Atlas, Seraph and Niobe generation
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.skenv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SKFLEET_PRODUCTION_POLICY=%h/.skcapstone/fleet/production.json
Environment=SKFLEET_AUTHORITY_HOST=chiap08
ExecStart=%h/.skenv/bin/python3 -m skcapstone.fleet.seat_cycle_orchestrator
TimeoutStartSec=660
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target

[Unit]
Description=SKFleet canonical serialized Atlas, Seraph and Niobe generation
After=network-online.target

[Service]
# Fleet authority/node service: files and dirs created here must be owner-only
# (a 0002 umask made evidence dirs 0775 and the guarded reviewer handoff refused them).
UMask=0077
Type=oneshot
Environment=PATH=%h/.skenv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SKFLEET_PRODUCTION_POLICY=%h/.skcapstone/fleet/production.json
Environment=SKFLEET_AUTHORITY_HOST=chiap08
ExecStartPre=-%h/.skenv/bin/skcapstone preflight
ExecStart=%h/.skenv/bin/python3 -m skcapstone.fleet.seat_cycle_orchestrator
TimeoutStartSec=660
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target

[Unit]
Description=Retire stale idle agent projections into reversible quarantine

[Service]
# Fleet authority/node service: files and dirs created here must be owner-only
# (a 0002 umask made evidence dirs 0775 and the guarded reviewer handoff refused them).
UMask=0077
Type=oneshot
ExecStart=%h/.skenv/bin/python3 %h/.local/bin/skfleet-projection-retire --apply

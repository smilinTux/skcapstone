[Unit]
Description=SKFleet Niobe canonical production dispatcher
After=network-online.target
OnFailure=skfleet-rotate-alert.service

[Service]
Type=oneshot
Environment=SKAGENT=niobe
Environment=SKCAPSTONE_AGENT=niobe
Environment=PATH=%h/.skenv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SKFLEET_PRODUCTION_POLICY=%h/.skcapstone/fleet/production.json
Environment=SKFLEET_AUTHORITY_HOST=chiap08
Environment=SKFLEET_WEDGE_MODE=enforce
Environment=SKFLEET_BEAT_INTERVAL=60
Environment=SKFLEET_MAIL_RECIPIENTS=jarvis
Environment=SKFLEET_EXCLUDED_MAIL_RECIPIENTS=lumina
ExecStart=%h/.skenv/bin/python3 -m skcapstone.niobe_live_entrypoint --activation %h/.skcapstone/coordination/niobe-activation.json --dispatcher %h/.skenv/bin/skfleet-rotate.py --unit skfleet-niobe-live.timer
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target

[Unit]
Description=SKFleet compatibility invocation of canonical production generation
After=network-online.target

[Service]
# Fleet authority/node service: files and dirs created here must be owner-only
# (a 0002 umask made evidence dirs 0775 and the guarded reviewer handoff refused them).
UMask=0077
Type=oneshot
ExecStart=/usr/bin/systemctl --user start skfleet-seat-cycle.service
TimeoutStartSec=660
NoNewPrivileges=yes

[Install]
WantedBy=default.target

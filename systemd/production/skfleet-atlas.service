[Unit]
Description=SKFleet Atlas governed postcondition verifier
After=network-online.target

[Service]
Type=oneshot
Environment=SKAGENT=atlas
Environment=SKCAPSTONE_AGENT=atlas
Environment=PATH=%h/.skenv/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=SKFLEET_PRODUCTION_POLICY=%h/.skcapstone/fleet/production.json
Environment=SKFLEET_AUTHORITY_HOST=chiap08
ExecStart=%h/.skenv/bin/python3 -m skcapstone.seat_cycle_entrypoint --seat atlas --home %h/.skcapstone --control-plane %h/.skcapstone/coordination/seat-control-plane.json
TimeoutStartSec=300
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ReadWritePaths=%h/.skcapstone/cards %h/.skcapstone/coordination/locks
ReadWritePaths=%h/.skcapstone/coordination/seat-cycles %h/.skcapstone/coordination/skmail.d
ReadWritePaths=%h/.skcapstone/evidence %h/.skcapstone/fleet
ReadWritePaths=%h/.pi/agent

[Install]
WantedBy=default.target

__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/
.eggs/
*.egg
.venv/
.env
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
~/

.stfolder
.stignore
# but DO ship the bundled Syncthing ignore templates under defaults/
!src/skcapstone/defaults/.stignore
!src/skcapstone/defaults/**/.stignore

# subagent-driven-development workspaces: per-plan scratch (ledger, task
# briefs, implementer reports, review packages). The skill treats these as
# git-ignored scratch, and a review package is a full -U10 diff, so they are
# large and duplicate what git already holds.
.superpowers/sdd/*/

# Claude Code subagent worktrees: ephemeral scratch checkouts the harness
# creates per subagent. Four sibling repos already ignore these; skcapstone
# did not, so an abandoned one showed up as a dirty shared checkout (44M,
# found 2026-10-11). Scoped to worktrees/ so a committed .claude/settings.json
# or .claude/agents/ stays trackable.
.claude/worktrees/
